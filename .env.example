# LLM Configuration (Open Source - Ollama)
# Download Ollama from https://ollama.ai
# Then run: ollama run llama2 (or mistral, neural-chat, etc.)
OLLAMA_API_URL=http://localhost:11434
AGENT_MODEL=llama2
# Alternative models: mistral, neural-chat, vicuna

# Agent Configuration
MAX_TOKENS=2000
TEMPERATURE=0.7

# Debug mode
DEBUG=False
