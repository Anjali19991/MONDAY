# LLM Configuration (Open Source - Ollama)
# Download Ollama from https://ollama.ai
# Then run: ollama run tinyllama (lightweight, 1.1GB, recommended for limited resources)
OLLAMA_API_URL=http://localhost:11434
AGENT_MODEL=tinyllama
# Alternative lightweight models: gemma:2b, orca-mini, neural-chat
# For more models: ollama run llama2, mistral, phi3:mini, etc.

# Agent Configuration
MAX_TOKENS=2000
TEMPERATURE=0.7

# Debug mode
DEBUG=False
